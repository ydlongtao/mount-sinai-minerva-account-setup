#!/bin/bash
#BSUB -J "sp_official_cells[1-8]"
#BSUB -P acc_DiseaseGeneCell
#BSUB -q premium
#BSUB -n 4
#BSUB -R "span[hosts=1] rusage[mem=12000]"
#BSUB -W 04:00
#BSUB -L /bin/bash
