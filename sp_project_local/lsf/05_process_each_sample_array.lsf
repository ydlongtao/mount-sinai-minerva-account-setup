#!/bin/bash
#BSUB -J sp_sample[1-10]
#BSUB -P acc_DiseaseGeneCell
#BSUB -q premium
#BSUB -n 8
#BSUB -R "rusage[mem=12000]"
#BSUB -W 04:00
#BSUB -L /bin/bash
#BSUB -o /sc/arion/work/huangl21/sp_project/logs/%J.%I.stdout
#BSUB -e /sc/arion/work/huangl21/sp_project/logs/%J.%I.stderr

set -euo pipefail

PROJECT_HOME=/sc/arion/work/huangl21/sp_project
source ~/miniconda3/etc/profile.d/conda.sh
conda activate omicverse
set -a
source "${PROJECT_HOME}/config/paths.env"
set +a
export TMPDIR=/sc/arion/scratch/huangl21/sp_project/${LSB_JOBID:-manual}_${LSB_JOBINDEX:-0}
mkdir -p "$TMPDIR" "${PROJECT_HOME}/logs"
export PYTHONPATH="${PROJECT_HOME}/scripts:${PYTHONPATH:-}"
export OMP_NUM_THREADS=${LSB_DJOB_NUMPROC:-8}

python "${PROJECT_HOME}/scripts/05_process_each_sample.py"
