mkdir -p "$TMPDIR" "$PROJECT_HOME/logs" "$SP_OFFICIAL_RESULTS" "$SP_OFFICIAL_WORK"
python -u "$PROJECT_HOME/scripts/49_validate_official_segmented_inputs.py"
