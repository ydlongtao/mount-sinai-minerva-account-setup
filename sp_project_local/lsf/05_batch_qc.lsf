#!/bin/bash
#BSUB -J sp_batch_qc
#BSUB -P acc_DiseaseGeneCell
#BSUB -q express
#BSUB -n 1
#BSUB -R "rusage[mem=8000]"
#BSUB -W 01:00
#BSUB -L /bin/bash
#BSUB -o /sc/arion/work/huangl21/sp_project/logs/%J.%I.stdout
#BSUB -e /sc/arion/work/huangl21/sp_project/logs/%J.%I.stderr

set -euo pipefail
PROJECT_HOME=/sc/arion/work/huangl21/sp_project
source ~/miniconda3/etc/profile.d/conda.sh
conda activate omicverse
export SP_PROJECT_HOME="$PROJECT_HOME"
export SP_PROJECT_SCRATCH=/sc/arion/scratch/huangl21/sp_project
export TMPDIR="${SP_PROJECT_SCRATCH}/${LSB_JOBID:-manual}"
mkdir -p "$TMPDIR" "$PROJECT_HOME/logs"
export PYTHONPATH="${PROJECT_HOME}/scripts:${PYTHONPATH:-}"

python "$PROJECT_HOME/scripts/18_prepare_batch_config.py"
python "$PROJECT_HOME/scripts/19_batch_qc_metrics.py"
