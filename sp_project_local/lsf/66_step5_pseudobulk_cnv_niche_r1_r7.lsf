#!/bin/bash
#BSUB -J "sp_step5_pseudobulk"
#BSUB -P acc_DiseaseGeneCell
#BSUB -q premium
#BSUB -n 8
#BSUB -R "rusage[mem=64000]"
#BSUB -R "span[hosts=1]"
#BSUB -W 08:00
#BSUB -L /bin/bash
#BSUB -o /sc/arion/work/huangl21/sp_project/logs/%J.%I.stdout
#BSUB -e /sc/arion/work/huangl21/sp_project/logs/%J.%I.stderr
set -euo pipefail
PROJECT_HOME=/sc/arion/work/huangl21/sp_project
source ~/miniconda3/etc/profile.d/conda.sh
conda activate omicverse
export TMPDIR=/sc/arion/scratch/huangl21/sp_project/${LSB_JOBID:-manual}
mkdir -p "$TMPDIR" "$PROJECT_HOME/logs"
export OMP_NUM_THREADS=${LSB_DJOB_NUMPROC:-8}
export OPENBLAS_NUM_THREADS=${LSB_DJOB_NUMPROC:-8}
export MKL_NUM_THREADS=${LSB_DJOB_NUMPROC:-8}
export PYTHONPATH="$PROJECT_HOME/scripts:${PYTHONPATH:-}"
python -u "$PROJECT_HOME/scripts/71_step5_pseudobulk_cnv_niche_r1_r7.py"
