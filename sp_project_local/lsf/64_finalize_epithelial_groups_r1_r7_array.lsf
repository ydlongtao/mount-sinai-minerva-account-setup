#!/bin/bash
#BSUB -J "sp_epi_final[1-2]"
#BSUB -P acc_DiseaseGeneCell
#BSUB -q express
#BSUB -n 2
#BSUB -R "rusage[mem=16000]"
#BSUB -R "span[hosts=1]"
#BSUB -W 01:00
#BSUB -L /bin/bash
#BSUB -o /sc/arion/work/huangl21/sp_project/logs/%J.%I.stdout
#BSUB -e /sc/arion/work/huangl21/sp_project/logs/%J.%I.stderr
set -euo pipefail
PROJECT_HOME=/sc/arion/work/huangl21/sp_project
source ~/miniconda3/etc/profile.d/conda.sh
conda activate omicverse
export TMPDIR=/sc/arion/scratch/huangl21/sp_project/${LSB_JOBID:-manual}
mkdir -p "$TMPDIR" "$PROJECT_HOME/logs"
export OMP_NUM_THREADS=${LSB_DJOB_NUMPROC:-2}
export PYTHONPATH="$PROJECT_HOME/scripts:${PYTHONPATH:-}"
SAMPLE=$(python - <<'PY'
import os
print(["SC000895-R1", "SC000895-R7"][int(os.environ.get("LSB_JOBINDEX", "1"))-1])
PY
)
python -u "$PROJECT_HOME/scripts/69_finalize_epithelial_groups_r1_r7.py" --sample "$SAMPLE"
