#!/bin/bash
#BSUB -J sp_corrected_cellpose_cpu
#BSUB -P acc_DiseaseGeneCell
#BSUB -q express
#BSUB -n 4
#BSUB -R "span[hosts=1] rusage[mem=24000]"
#BSUB -W 04:00
#BSUB -L /bin/bash
#BSUB -o /sc/arion/work/huangl21/sp_project/logs/%J.0.stdout
#BSUB -e /sc/arion/work/huangl21/sp_project/logs/%J.0.stderr
set -euo pipefail
PROJECT_HOME=/sc/arion/work/huangl21/sp_project
source ~/miniconda3/etc/profile.d/conda.sh
conda activate "${SP_CORRECTED_CONDA_ENV:-omicverse}"
source "$PROJECT_HOME/scripts/v2_no_legacy_env.sh"
export SP_PROJECT_MANIFEST="$PROJECT_HOME/config/sample_manifest_v2_corrected.csv"
export SP_PROJECT_BATCH_RESULTS="$PROJECT_HOME/results/batch_v2_corrected"
export SP_PROJECT_BATCH_WORK="$PROJECT_HOME/work/batch_v2_corrected"
export SP_PROJECT_CONFIG="$PROJECT_HOME/config/batch_analysis_v2_corrected.yaml"
export SP_CELLPOSE_USE_GPU=0
# Compute nodes do not have outbound DNS/network access.  Use the shared
# pretrained Cellpose model cached during the successful GPU pilot.
export CELLPOSE_LOCAL_MODELS_PATH=/sc/arion/work/huangl21/cellpose_models
export TMPDIR="$SP_PROJECT_SCRATCH/${LSB_JOBID:-manual}"
mkdir -p "$TMPDIR" "$PROJECT_HOME/logs"
export OMP_NUM_THREADS=${LSB_DJOB_NUMPROC:-4}
python -u "$PROJECT_HOME/scripts/22_cellpose_he_each_sample.py" --sample-id "${SP_CORRECTED_SAMPLE:?Set SP_CORRECTED_SAMPLE}" --force
