#BSUB -P acc_DiseaseGeneCell
#BSUB -q express
#BSUB -n 4
#BSUB -R "span[hosts=1] rusage[mem=24000]"
#BSUB -W 04:00
#BSUB -L /bin/bash
#BSUB -o /sc/arion/work/huangl21/sp_project/logs/%J.%I.stdout
#BSUB -e /sc/arion/work/huangl21/sp_project/logs/%J.%I.stderr

set -euo pipefail
PROJECT_HOME=/sc/arion/work/huangl21/sp_project
source ~/miniconda3/etc/profile.d/conda.sh
conda activate /sc/arion/work/huangl21/conda_envs/infercnvpy
export TMPDIR=/sc/arion/scratch/huangl21/sp_project/${LSB_JOBID:-manual}
mkdir -p "$TMPDIR" "$PROJECT_HOME/logs"
export OMP_NUM_THREADS=${LSB_DJOB_NUMPROC:-4}
export MKL_NUM_THREADS=${LSB_DJOB_NUMPROC:-4}
export SP_PROJECT_HOME="$PROJECT_HOME"
export SP_HG38_REF=/sc/arion/work/huangl21/references/hg38/gencode38

case "${LSB_JOBINDEX:-1}" in
  1) SAMPLE=SC000895-R1 ;;
  2) SAMPLE=SC000895-R7 ;;
  *) echo "Unsupported LSB_JOBINDEX=${LSB_JOBINDEX:-}" >&2; exit 2 ;;
esac

python -u "$PROJECT_HOME/scripts/63_run_infercnv_pilot_r1_r7.py" \
  --sample "$SAMPLE" --max-query 40000
