#!/bin/bash
#BSUB -J "sp_official_cell_coarse[1-8]"
#BSUB -P acc_DiseaseGeneCell
#BSUB -q premium
#BSUB -n 8
#BSUB -R "span[hosts=1] rusage[mem=24000]"
#BSUB -W 08:00
#BSUB -L /bin/bash
#BSUB -o /sc/arion/work/huangl21/sp_project/logs/%J.%I.stdout
