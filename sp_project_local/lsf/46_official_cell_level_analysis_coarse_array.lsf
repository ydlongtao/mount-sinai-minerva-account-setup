set -euo pipefail
PROJECT_HOME=/sc/arion/work/huangl21/sp_project
source ~/miniconda3/etc/profile.d/conda.sh
conda activate omicverse
source "$PROJECT_HOME/scripts/official_segmented_v1_env.sh"
export TMPDIR="$SP_PROJECT_SCRATCH/${LSB_JOBID:-manual}_${LSB_JOBINDEX:-manual}"
export OMP_NUM_THREADS=${LSB_DJOB_NUMPROC:-8}
export OPENBLAS_NUM_THREADS=${LSB_DJOB_NUMPROC:-8}
mkdir -p "$TMPDIR" "$PROJECT_HOME/logs"
python -u "$PROJECT_HOME/scripts/53_official_cell_level_analysis_coarse.py"
