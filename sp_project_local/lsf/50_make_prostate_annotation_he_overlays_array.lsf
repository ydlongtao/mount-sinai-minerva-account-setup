export PYTHONPATH="$PROJECT_HOME/scripts:${PYTHONPATH:-}"
if [ "${LSB_JOBINDEX}" = 1 ]; then SAMPLE=SC000895-R1; else SAMPLE=SC000895-R7; fi
python -u "$PROJECT_HOME/scripts/57_make_prostate_annotation_he_overlays.py" --sample "$SAMPLE"
